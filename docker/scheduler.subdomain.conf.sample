# SWAG 試作版範本：比照 Tower 上 proxy-confs/oc.subdomain.conf 改寫
# 正式檔名：scheduler.subdomain.conf（子網域名稱待定，見 HANDOFF）
# 重點：
#   1. upstream 指到 hotel-scheduler:8765（proxynet 內容器名解析）
#   2. 一定要 include cf-allow.conf（防 WAN IP + Host 直接繞過 CF Access，oc 2026-10-01 教訓）
#   3. 擋掉桌面版 kill switch（容器內本來就是 no-op，多一層保險）
#   4. 認證二選一或疊加：CF Access（雲端設）+ htpasswd（這裡開）

server {
    listen 443 ssl;
    listen [::]:443 ssl;

    server_name scheduler.*;

    include /config/nginx/ssl.conf;

    client_max_body_size 50M;

    # 防繞過：只允許 Cloudflare 進來
    include /config/nginx/cf-allow.conf;

    # 桌面版 kill switch：對外一律 403
    location = /api/v1/lifecycle/shutdown { return 403; }
    location = /api/v1/lifecycle/shutdown-signal { return 403; }

    location / {
        # 基本網頁驗證（試作期建議先開，帳密用 htpasswd 產生）：
        # auth_basic "Restricted";
        # auth_basic_user_file /config/nginx/.htpasswd-scheduler;

        include /config/nginx/proxy.conf;
        resolver 127.0.0.11 valid=30s;
        set $upstream_app hotel-scheduler-test;
        set $upstream_port 8765;
        proxy_pass http://$upstream_app:$upstream_port;
    }
}
